INTERNAL_SERVICE_URL=http://localhost/api/v3
PUBLIC_SERVICE_URL=http://localhost/api/v3
PUBLIC_OIDC_CACHE_KEY_ID_TOKEN_SUFFIX=@@user@@
PUBLIC_OIDC_CACHE_KEY_PREFIX=oidc.user

# Alt 2.3 participant OIDC PoC. Off by default.
# Simulator:
# PUBLIC_ENABLE_OIDC_LOGIN=true
# PUBLIC_AUTH_ISSUER=https://localhost:3000/
# PUBLIC_AUTH_CLIENT_ID=dev-client-id
# PUBLIC_AUTH_AUDIENCE=users
#
# Idura Verify (uses @criipto/verify-react when issuer host contains idura.broker):
# PUBLIC_ENABLE_OIDC_LOGIN=true
# PUBLIC_AUTH_ISSUER=https://example.test.idura.broker
# PUBLIC_AUTH_CLIENT_ID=urn:example:client-id
# Server: AUTH_ISSUER must match the token issuer, AUTH_AUDIENCE its `aud`
# (usually the Idura client ID), and JWKS_URI the Idura JWKS endpoint.
